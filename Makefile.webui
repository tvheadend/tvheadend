#
# Configuration
#

include $(dir $(lastword $(MAKEFILE_LIST)))Makefile.common
IAM=$(firstword $(MAKEFILE_LIST))
TOPDIR=$(dir $(IAM))
include $(TOPDIR)/.config.mk
WEBDIR ?= src/webui
LANGUAGES ?= $(LANGUAGES_ALL)
GZIPCMD += -n
XGETTEXT2 ?= $(XGETTEXT) --language=JavaScript --from-code=utf-8  --add-comments=/ -k_ -kN_ -s
POJS_PY = PYTHONIOENCODING=utf-8 $(PYTHON) support/pojs.py
VUE_XGETTEXT_PY = PYTHONIOENCODING=utf-8 $(PYTHON) support/vue_xgettext.py

#
# Internationalization
#
VUE-JSI-FILES = $(foreach f,$(LANGUAGES),src/webui/static/intl/tvh-vue.$(f).js.gz)

# The Vue UI has its own template, extracted from its sources
VUE_I18N_SRC = $(shell find $(WEBDIR)/static-vue/src \( -name '*.ts' -o -name '*.vue' \) \
                 ! -name '*.test.ts' ! -path '*/__tests__/*' ! -path '*/__helpers__/*' \
                 ! -path '*/views/_dev/*' | LC_ALL=C sort)
VUE_I18N_TMP = $(BUILDDIR)/intl-vue

ifndef V
VV = @
endif

define go-po
	@printf "Building $(1)\n"
	@mkdir -p $(dir $(1))
	$(VV)$(POJS_PY) --in="$(2)" > $(1).new
	@echo "tvh_locale_lang = '$(subst .,,$(suffix $(basename $(2))))';" >> $(1).new
	$(VV)$(GZIPCMD) -c $(1).new > $@.new2
	@rm $(1).new
	@mv $(1).new2 $(1)
endef

all: $(VUE-JSI-FILES)

# Internationalization
.PHONY: intl
intl:
	@printf "Building intl/vue/tvheadend.vue.pot\n"
	@rm -rf $(VUE_I18N_TMP)
	@$(VUE_XGETTEXT_PY) --out=$(VUE_I18N_TMP) $(VUE_I18N_SRC)
	@$(XGETTEXT2) -D $(VUE_I18N_TMP) -o intl/vue/tvheadend.vue.pot.new $(VUE_I18N_SRC)
	@sed -e 's/^"Language: /"Language: en/' < intl/vue/tvheadend.vue.pot.new > intl/vue/tvheadend.vue.pot
	@rm -rf $(VUE_I18N_TMP)

src/webui/static/intl/tvh-vue.%.js.gz: intl/vue/tvheadend.vue.%.po
	$(call go-po,$@,$<)
