msgstr "L'esito dell'ultima scansione eseguita."

#: src/input/mpegts/mpegts_mux_dvb.c:267 src/input/mpegts/mpegts_mux_dvb.c:339
#: src/input/mpegts/mpegts_mux_dvb.c:900
#: src/input/mpegts/mpegts_mux_dvb.c:1087
