#: src/input/mpegts/satip/satip.c:353
msgid ""
"Enable if the SAT>IP box requests plts=on parameter in the SETUP RTSP "
"command for DVB-S2 muxes."
msgstr "Ενεργοποιήστε αν η συσκευή SAT>IP απαιτεί την παράμετρο plts=on στην εντολή RTSP SETUP για πολυπλέκτες DVB-S2."

#: src/input/mpegts/satip/satip.c:374
msgid "Enable if the SAT>IP box requires pids=21 parameter in the SETUP RTSP command"
msgstr "Ενεργοποιήστε αν η συσκευή SAT>IP απαιτεί την παράμετρο pids=21 στην εντολή RTSP SETUP."

#: src/input/mpegts/satip/satip.c:363
msgid ""
"Enable if the SAT>IP box requires ro= parameter in the SETUP RTSP command "
"for DVB-S2 muxes."
msgstr "Ενεργοποιήστε αν η συσκευή SAT>IP απαιτεί την παράμετρο ro= στην εντολή RTSP SETUP για πολυπλέκτες DVB-S2."

#: src/input/mpegts/satip/satip.c:333
msgid "Enable if the SAT>IP box supports the addpids/delpids commands."
msgstr "Ενεργοποιήστε αν η συσκευή SAT>IP υποστηρίζει τις εντολές addpids/delpids."

#: src/input/mpegts/satip/satip.c:342
msgid ""
"Enable if the SAT>IP box supports the frontend identifier. This allows the "
"auto-tuner allocation, but it might cause trouble for boxes with different "
"tuner reception connections like satellite inputs."
msgstr "Ενεργοποιήστε την αν η συσκευή SAT>IP υποστηρίζει αναγνωριστικό μονάδας λήψης (frontend). Επιτρέπει αυτόματη κατανομή δεκτών, αλλά ενδέχεται να προκαλέσει προβλήματα σε συσκευές με διαφορετικές συνδέσεις λήψης, όπως δορυφορικές εισόδους."

#: src/input/mpegts/satip/satip.c:289
