msgstr "Το όνομα του καναλιού (έτσι θα εμφανίζεται στο EPG)."

#: src/profile.c:315
msgid "The name of the profile."
msgstr "Το όνομα του προφίλ."

#: src/dvr/dvr_autorec.c:1157
msgid "The name of the the rule."
msgstr "Το όνομα του κανόνα."

#: src/access.c:2485
