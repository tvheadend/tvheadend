#: src/docs_inc.c:2573
msgid "The master ATSC-T frontend (most ATSC-T tuners use this type)."
msgstr ""
"Il frontend principale ATSC-T (la maggior parte dei sintonizzatori ATSC-T "
"usa questo tipo)."

#: src/docs_inc.c:2581
msgid "The master DVB-C/C2 frontend (most DVB-C tuners use this type)."
msgstr ""
"Il frontend principale DVB-C/C2 (la maggior parte dei sintonizzatori DVB-C "
"usa questo tipo)."

#: src/docs_inc.c:2557
msgid "The master DVB-S/S2 frontend (most DVB-S tuners use this type)."
msgstr ""
"Il frontend principale DVB-S/S2 (la maggior parte dei sintonizzatori DVB-S "
"usa questo tipo)."

#: src/docs_inc.c:2569
msgid "The master DVB-T/T2 frontend (most DVB-T tuners use this type)."
msgstr ""
"Il frontend principale DVB-T/T2 (la maggior parte dei sintonizzatori DVB-T "
"usa questo tipo)."

#: src/docs_inc.c:2589
msgid "The master ISDB-C frontend (most ISDB-C tuners use this type)."
msgstr ""
"Il frontend principale ISDB-C (la maggior parte dei sintonizzatori ISDB-C "
