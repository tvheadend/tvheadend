#!/bin/sh -e

HTS_USER="hts"

. /usr/share/debconf/confmodule
db_version 2.0

case "$1" in
purge)
    if getent passwd "$HTS_USER" >/dev/null; then
        rm -rf "$(getent passwd "$HTS_USER" | cut -d':' -f6)"
        userdel "$HTS_USER"
    fi
    if getent group "$HTS_USER" >/dev/null; then
        groupdel "$HTS_USER"
    fi
    db_purge
   ;;
esac

#DEBHELPER#

exit 0
